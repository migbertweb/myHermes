# =============================================================================
# ~/.hermes/.gitignore — keep only user config & custom artifacts
# Everything auto-generated on a fresh install is ignored.
# =============================================================================

# --- Installation artifacts (auto-downloaded on fresh install) ---------------
hermes-agent/
tools/
installs/
lsp/
impeccable-repo/
node_modules/
__pycache__/
*.pyc

# --- Large runtime caches & state --------------------------------------------
cache/
state/
logs/
mnemosyne/models/
mnemosyne/data/
audio_cache/
image_cache/
desktop/
gateway/
hooks/
pairing/
plugin-data/
plugin-update-checks/
platforms/
bot_relay/
pending/
pending_messages/
runtime/
source-checks/
terminal-sessions/
sessions/
backups/
.curator_backups/

# --- Per-profile runtime (mirrors the root patterns) --------------------------
profiles/*/cache/
profiles/*/logs/
profiles/*/sessions/
profiles/*/state/
profiles/*/tools/
profiles/*/installs/
profiles/*/lsp/
profiles/*/node_modules/
profiles/*/hooks/
profiles/*/pairing/
profiles/*/plugin-data/
profiles/*/plugin-update-checks/
profiles/*/platforms/
profiles/*/bot_relay/
profiles/*/pending/
profiles/*/pending_messages/
profiles/*/runtime/
profiles/*/source-checks/
profiles/*/terminal-sessions/
profiles/*/sessions/
profiles/*/backups/
profiles/*/.curator_backups/
profiles/*/skills/
profiles/*/cron/

# --- SQLite databases (all of them are runtime) ------------------------------
*.db
*.db-wal
*.db-shm

# --- Locks & temp files ------------------------------------------------------
*.lock
*.tmp
*.sync-conflict-*

# --- Model caches ------------------------------------------------------------
models_dev_cache.json
models_dev_cache.etag
ollama_cloud_models_cache.json
provider_models_cache.json
context_length_cache.yaml
.channel_directory.json
config.channels.lock
.tui-theme-boot.json
.web-ui-build-stamp.json
.desktop-build-stamp.json
.gateway_state.json
.gateway.pid
.gateway.lock
.gateway-starts.log
.gateway_migration.json
.install_id
.install_id.lock
.no-bundled-skills
.npm_lock_hash_*
.restart_last_processed.json
.scratch_tip_shown
.processes.json
.spawn-ledger.json
.stfolder
.stignore
.skills_prompt_snapshot.json
.hermes_history
.mcp-discovery.lock

# --- Sensitive credentials (keys live in .env / secret stores, never here) ---
.env
profiles/*/.env
auth.json
auth/
google_client_secret.json
google_token.json
mcp-tokens/
shared/nous_auth.json
shared/

# --- Misc runtime ------------------------------------------------------------
bin/
cron/
assets/avatar.png
pastes/
pets/
profiles/*/bin/
profiles/*/assets/
profiles/*/pastes/
profiles/*/pets/
profiles/*/state.db
profiles/*/*.db
profiles/*/*.db-wal
profiles/*/*.db-shm
profiles/*/verification_evidence.db*
profiles/*/response_store.db*
profiles/*/projects.db*
profiles/*/memory_store.db*
profiles/*/shared-state.db*
profiles/*/runs_idempotency.db*
profiles/*/notepad.db
profiles/*/executions.db
profiles/*/auth.json
profiles/*/auth/
profiles/*/google_client_secret.json
profiles/*/google_token.json
profiles/*/mcp-tokens/
profiles/*/shared/
profiles/*/.curator_backups/
# Additional runtime files
gateway_state.json
gateway-starts.log
gateway.pid
gateway_migration.json
desktop-build-stamp.json
web-ui-build-stamp.json
spawn-ledger.json
processes.json
channel_directory.json
install_id
ack.config.yaml
config.yaml.bak
back.env
.state.db.*
.shared-state.db.*
.kanban.db.*
